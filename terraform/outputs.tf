# ---- Outputs (consumed by deploy-azure.sh; the Ansible inventory itself is
#      generated by inventory.tf, so nothing here needs copy/paste) -----------

output "resource_group_name" {
  description = "Lab resource group (for az vm deallocate/start)"
  value       = azurerm_resource_group.lab.name
}

output "access_mode" {
  description = "tailscale (private, via tailnet) or public (NSG-locked public IPs)"
  value       = var.access_mode
}

output "access_addresses" {
  description = "Address of each VM as seen from your Kali (private IPs in tailscale mode)"
  value       = local.access_address
}

output "dc_address" {
  description = "HYDRA-DC address from your Kali"
  value       = local.access_address["HYDRA-DC"]
}

output "tailscale_hostname" {
  description = "HYDRA-DC's machine name in your tailnet (tailscale mode)"
  value       = local.tailnet ? var.tailscale_hostname : null
}

output "lab_subnet" {
  description = "Lab subnet advertised over Tailscale"
  value       = var.address_space
}

output "workstation_image" {
  description = "Image the workstations were built from"
  value       = "${local.ws_image.publisher}:${local.ws_image.offer}:${local.ws_image.sku}:${local.ws_image.version}"
}

output "inventory_path" {
  description = "Generated Ansible inventory"
  value       = abspath(local_file.ansible_inventory.filename)
}
