# =============================================================================
#  inventory.tf — auto-generate the Ansible inventory after apply
#  Terraform writes each VM's address (private IP in tailscale mode, public IP
#  in public mode) + connection creds straight into
#  ansible/inventory/azure_generated.yml (gitignored, mode 0600), so there's no
#  copy/paste between terraform output and ansible.
#
#  YAML via yamlencode() so any password characters (#, ;, quotes, spaces) are
#  quoted correctly — INI inventories mangle those.
#
#  NOTE: no domain-admin password here. The credential used for domain joins is
#  defined once in ansible/group_vars/all.yml (lab_admin_account).
# =============================================================================

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/azure_generated.yml"
  file_permission = "0600"

  content = join("\n", [
    "# AUTO-GENERATED by Terraform — do not edit by hand. Regenerated on every apply.",
    yamlencode({
      all = {
        vars = {
          lab_platform                         = "azure"
          ansible_connection                   = "winrm"
          ansible_port                         = 5986
          ansible_winrm_scheme                 = "https"
          ansible_winrm_transport              = "ntlm"
          ansible_winrm_server_cert_validation = "ignore"
          ansible_winrm_read_timeout_sec       = 120
          ansible_winrm_operation_timeout_sec  = 100
          ansible_user                         = var.admin_username
          ansible_password                     = var.admin_password
        }
        children = {
          dc = {
            hosts = {
              "HYDRA-DC" = {
                ansible_host = local.access_address["HYDRA-DC"]
                ws_name      = "HYDRA-DC"
              }
            }
          }
          workstations = {
            hosts = {
              for name, ip in var.workstation_ips : name => {
                ansible_host = local.access_address[name]
                ws_name      = name
                ws_ip        = ip
              }
            }
          }
        }
      }
    })
  ])

  depends_on = [
    azurerm_virtual_machine_run_command.bootstrap
  ]
}

# Handy: print the attacker cheat-sheet after apply
resource "local_file" "attack_info" {
  filename        = "${path.module}/../ATTACK_FROM_KALI.txt"
  file_permission = "0600"
  content         = <<-EOT
    ================================================================
     MARVEL.local lab — deployed to Azure (access: ${var.access_mode})
    %{if local.tailnet~}
     Reachable ONLY through your tailnet: HYDRA-DC (${var.tailscale_hostname})
     routes ${var.address_space}. No public IPs, no inbound internet rules.
     Kali needs:  sudo tailscale set --accept-routes
    %{else~}
     Reachable ONLY from ${coalesce(var.allowed_source_ip, "<unset>")} (NSG)
    %{endif~}
    ================================================================

    DC (HYDRA-DC)     : ${local.access_address["HYDRA-DC"]}   (private ${var.dc_private_ip})
    %{for name, ip in var.workstation_ips~}
    ${name}  : ${local.access_address[name]}   (private ${ip})
    %{endfor~}
    Workstation OS    : ${var.workstation_os} (${local.ws_image.offer}/${local.ws_image.sku})

    Domain : MARVEL.local
    Foothold creds : MARVEL\fcastle : Password1

    --- Add to /etc/hosts on your Kali ---
    ${local.access_address["HYDRA-DC"]} hydra-dc.marvel.local hydra-dc marvel.local

    --- Verify the build (see documentation/runbook.md) ---
    nxc smb ${local.access_address["HYDRA-DC"]} -u fcastle -p Password1 -d MARVEL.local
    impacket-GetUserSPNs -dc-ip ${local.access_address["HYDRA-DC"]} MARVEL.local/fcastle:Password1

    NOTE: LLMNR/NBT-NS poisoning, NTLM relay and mitm6 need layer-2 adjacency;
    neither the internet nor a Tailscale tunnel carries broadcast/multicast.
    Routed techniques (enum, Kerberoast, DCSync, BloodHound, PtH) work.
    See documentation/security-model.md.
  EOT
}
